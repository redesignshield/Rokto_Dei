# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Optional Google Maps JS API key with HTTP referrer restrictions.
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_API_BASE_URL: Optional hosted backend origin for standalone Capacitor/APK builds (leave blank for Web/TWA).
VITE_API_BASE_URL=""

# ANDROID_PACKAGE_NAME & ASSETLINKS_SHA256: Set after generating APK signing keystore to verify Android TWA domain.
ANDROID_PACKAGE_NAME="com.roktodei.app"
ASSETLINKS_SHA256=""

# ALLOWED_CORS_ORIGINS: Comma-separated extra origins allowed to call /api/contact-gate.
ALLOWED_CORS_ORIGINS=""
